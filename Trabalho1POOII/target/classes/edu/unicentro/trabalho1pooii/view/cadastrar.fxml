                <Label text="Nome" GridPane.halignment="RIGHT" GridPane.valignment="CENTER">
               <font>
                  <Font size="19.0" />
               </font></Label>
                <Label text="Senha" GridPane.halignment="RIGHT" GridPane.rowIndex="1" GridPane.valignment="CENTER">
               <font>
                  <Font size="19.0" />
