<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="430.0" prefWidth="675.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.unicentro.trabalho1pooii.controller.NotaController">
    <children>
        <MenuBar>
            <menus>
                <Menu mnemonicParsing="false" text="Nota">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#btnSalvarOnAction" text="Salvar" />
                        <MenuItem fx:id="miExcluir" mnemonicParsing="false" onAction="#btnExcluirOnAction" text="Excluir" />
                        <MenuItem mnemonicParsing="false" onAction="#btnVoltarOnAction" text="Voltar" />
                  <MenuItem fx:id="miFixar" mnemonicParsing="false" onAction="#miFixarOnAction" text="Fixar" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <TextField fx:id="txtTitulo" promptText="Título da nota">
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
        </TextField>
        <TextArea fx:id="txtTexto" promptText="Escreva aqui sua nota!" wrapText="true" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </VBox.margin>
        </TextArea>
    </children>
</VBox>
